# ============================================================
# 포털 서버 설정 프로파일 (예시)
# ------------------------------------------------------------
# 사용법: 이 파일을 저장소 루트에 `.env` 로 복사한 뒤 값을 채운다.
#   copy config\server.env.example .env
# `.env` 는 git 이 추적하지 않는다(.gitignore). 비밀값은 반드시
# `.env` 에만 두고, 이 예시 파일이나 문서에는 자리표시자만 쓴다.
#
# 아무 값도 설정하지 않으면 서버는 "로컬 단독 모드"(127.0.0.1 전용)로
# 뜬다 — 개발 PC 의 기존 동작과 동일하다.
# ============================================================

# ---- 접속 (서버로 쓸 때만 변경) --------------------------------
# 바인드 주소. 로컬 단독=127.0.0.1(기본), 외부 접속 허용=0.0.0.0
#PORTAL_BIND_HOST=0.0.0.0

# 브라우저 주소창에 입력되는 호스트의 허용목록(쉼표 구분).
# 여기 없는 주소로 들어온 요청은 421 로 거부된다.
# 예) 집 LAN:      192.168.0.10:8787
# 예) 터널/프록시:  portal.example.com   (https 도메인은 포트 없이)
#PORTAL_ALLOWED_HOSTS=192.168.0.10:8787

# 포트 (기본 8787)
#PORT=8787

# ---- 배포 등급·계정·인증 (필수) --------------------------------
# 로컬 개발: local + local-dev. 이 조합은 loopback 바인딩에서만 시작된다.
# 시험운영/운영: pilot 또는 production + cloudflare-access.
# smtp 값은 예약되어 있지만 메일 발송 어댑터 구현 전에는 시작을 거부한다.
# pilot/production은 PORTAL_ALLOWED_HOSTS와 40자리 체커 커밋 고정값도 필수다.
#PORTAL_DEPLOYMENT_MODE=production
#PORTAL_AUTH_PROVIDER=cloudflare-access
# 가입 허용 이메일 도메인 (기관 프로파일 — 확산 시 이 값만 교체)
#PORTAL_ALLOWED_EMAIL_DOMAINS=gg.go.kr,korea.kr
# 이전 PORTAL_AUTH_MODE 변수는 폐기 예정이며 새 서버 설정에 사용하지 않는다.
# 사용자당 동시 점검 상한 (기본 1)
#PORTAL_USER_CONCURRENT_SCANS=1
# 계정 데이터 위치 (코드 밖 절대경로)
#PORTAL_ACCOUNT_DIR=C:\portal-data\accounts

# ---- Cloudflare Access 연동 (터널을 쓸 때만) ---------------------
# 관문을 통과한 요청의 서명 JWT 를 검증해 포털 로그인을 대체한다(원클릭 시작).
# 원격 팀 도메인은 HTTPS만 허용한다(HTTP는 loopback 통합 테스트에서만 허용).
# 두 값을 모두 설정해야 서버가 시작된다. Access 모드에는 개발용 매직링크 대체 경로가 없다.
# 팀 도메인: Zero Trust 설정의 <팀이름>.cloudflareaccess.com
#PORTAL_ACCESS_TEAM_DOMAIN=<팀이름>.cloudflareaccess.com
# 애플리케이션 AUD 태그: Access 앱 상세의 Audience 값
# (로그인 리다이렉트 URL 의 kid= 값과 같다)
#PORTAL_ACCESS_AUD=<Access 앱 Audience 태그>

# ---- 관리자 ---------------------------------------------------
# 관리자 계정 ID (이메일 형식)
#ADMIN_ID=<관리자 이메일>
# 최초 기동 시 1회 사용되는 초기 비밀번호. 첫 로그인 후 변경.
#ADMIN_INITIAL_PASSWORD=<초기 비밀번호>
# 개발·운영의 관리자 계정을 같은 값으로 강제할 때만 true.
# 두 환경의 ADMIN_ID/ADMIN_INITIAL_PASSWORD를 같게 설정한 뒤 켠다.
# 서버를 다시 시작할 때 저장된 관리자 해시도 해당 비밀번호로 동기화한다.
#ADMIN_CREDENTIALS_SYNC=false

# ---- 데이터 위치 (서버 표준: 코드 폴더 밖 절대경로) ---------------
# git 배포가 데이터를 건드리지 않도록 저장소 밖에 둔다.
#PORTAL_SCAN_HISTORY_FILE=C:\portal-data\scan-history.jsonl
#PORTAL_OBSERVATION_DIR=C:\portal-data\observations
#PORTAL_WHITELIST_DIR=C:\portal-data\whitelist
#PORTAL_REPORT_DIR=C:\portal-data\reports
#ADMIN_AUTH_FILE=C:\portal-data\admin-auth.json

# ---- 보고서 보존기한 (P5) --------------------------------------
# 서버 보관 보고서의 자동 삭제 기한(일). 기본 90, 0이면 자동 삭제 없음.
# 기관 정책 확정 시 이 값만 바꾸면 화면 고지도 함께 바뀐다.
#PORTAL_REPORT_RETENTION_DAYS=90

# ---- 용량·동시성 (기본값이 무난, 서버 사양에 맞게만 조정) ----------
# 체커 동시 실행 상한 (기본: min(4, 코어수-2))
#PORTAL_MAX_CONCURRENT_SCANS=4
# 대기열 상한 (기본 20)
#PORTAL_SCAN_QUEUE_LIMIT=20
# 점검 타임아웃 ms (기본: 간편 5분 / 표준 20분)
#PORTAL_SCAN_TIMEOUT_QUICK_MS=300000
#PORTAL_SCAN_TIMEOUT_STANDARD_MS=1200000
# 디스크 여유 임계 바이트 (기본 2GB) — 미만이면 접수 503
#PORTAL_MIN_FREE_DISK_BYTES=2147483648

# ---- Checker identity ------------------------------------------
# Set this to the full 40-character SHA in config/checker.commit.
# The portal returns health 503 and refuses scans when it differs.
#PORTAL_EXPECTED_CHECKER_COMMIT=<config/checker.commit SHA>
